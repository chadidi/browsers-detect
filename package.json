{
  "name": "browsers-detect",
  "version": "0.2.0",
  "description": "Detect installed desktop browsers and their local profiles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/**/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "browser",
    "browser-detection",
    "profiles",
    "desktop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chadidi/browsers-detect.git"
  },
  "bugs": {
    "url": "https://github.com/chadidi/browsers-detect/issues"
  },
  "homepage": "https://github.com/chadidi/browsers-detect#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  }
}